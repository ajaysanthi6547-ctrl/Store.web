
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Admin Dashboard</h2>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post">

            <button type="submit" class="btn btn-danger">
                Logout
            </button>
        </form>
    </div>

    <p class="text-muted">
        Welcome to Santhi.Store Admin Panel
    </p>

    @if (ViewBag.LowStockCount > 0)
    {
        <div class="alert alert-warning mt-3">
            <h5>⚠️ Low Stock Alert!</h5>

            <p class="mb-2">
                You have <strong>@ViewBag.LowStockCount</strong>
                products with low stock (below 10 items).
            </p>

            <a asp-controller="Admin"
               asp-action="Inventory"
               class="btn btn-warning btn-sm">
                Check Inventory
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-success mt-3">
            All products have sufficient stock!
        </div>
    }

    <div class="row g-4">

        <!-- Products -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 h-100">
                <div class="card-body">
                    <h5>Products</h5>
                    <h3>Manage Products</h3>

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-primary mt-3">
                        View Products
                    </a>
                </div>
            </div>
        </div>

        <!-- Add Product -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 h-100">
                <div class="card-body">
                    <h5>Add Product</h5>
                    <h3>New Product</h3>

                    <a asp-controller="Product"
                       asp-action="Create"
                       class="btn btn-success mt-3">
                        Add Product
                    </a>
                </div>
            </div>
        </div>

        <!-- Orders -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 h-100">
                <div class="card-body">
                    <h5>Orders</h5>
                    <h3>Manage Orders</h3>

                    <a asp-controller="Admin"
                       asp-action="Orders"
                       class="btn btn-primary mt-3">
                        View Orders
                    </a>
                </div>
            </div>
        </div>

        <!-- Inventory -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 h-100">
                <div class="card-body">
                    <h5>Inventory</h5>
                    <h3>Manage Stock</h3>

                    <a asp-controller="Admin"
                       asp-action="Inventory"
                       class="btn btn-warning mt-3">
                        View Inventory
                    </a>
                </div>
            </div>
        </div>

        <!-- Customers -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 h-100">
                <div class="card-body">
                    <h5>Customers</h5>
                    <h3>Manage Customers</h3>

                    <a asp-controller="Admin"
                       asp-action="Customers"
                       class="btn btn-primary mt-3">
                        View Customers
                    </a>
                </div>
            </div>
        </div>

        <!-- Sales Report -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3 h-100">
                <div class="card-body">
                    <h5>Sales Report</h5>
                    <h3>View Business Sales</h3>

                    <a asp-controller="Admin"
                       asp-action="SalesReport"
                       class="btn btn-success mt-3">
                        View Sales Report
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
```