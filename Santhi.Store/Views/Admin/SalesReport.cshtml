
@{
    ViewData["Title"] = "Sales Report";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Sales Report Dashboard</h2>
            <p class="text-muted">Business performance overview</p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-primary">
            Back to Dashboard
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3">

        <div class="col-md-4">
            <div class="card bg-primary text-white shadow h-100">
                <div class="card-body">
                    <h5>Total Sales</h5>
                    <h3>₹@(((decimal)ViewBag.TotalSales).ToString("N2"))</h3>
                    <p class="mb-0">All non-cancelled orders</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-success text-white shadow h-100">
                <div class="card-body">
                    <h5>Total Orders</h5>
                    <h3>@ViewBag.TotalOrders</h3>
                    <p class="mb-0">Non-cancelled orders</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-info text-white shadow h-100">
                <div class="card-body">
                    <h5>Total Customers</h5>
                    <h3>@ViewBag.TotalCustomers</h3>
                    <p class="mb-0">Registered customers</p>
                </div>
            </div>
        </div>

    </div>

    <!-- Monthly Sales Chart -->
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body p-4">

            <h4 class="mb-1">Monthly Sales Overview</h4>
            <p class="text-muted">
                Sales performance for the last 12 months
            </p>

            <div style="position: relative; height: 350px;">
                <canvas id="monthlySalesChart"></canvas>
            </div>

        </div>
    </div>

    <!-- Best Selling Products -->
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body">

            <h4>Best-Selling Products</h4>

            <div class="table-responsive">
                <table class="table table-bordered table-striped mt-3">

                    <thead class="table-dark">
                        <tr>
                            <th>Product Name</th>
                            <th>Total Quantity Sold</th>
                            <th>Total Revenue</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var product in ViewBag.BestSellingProducts)
                        {
                            <tr>
                                <td>@product.ProductName</td>
                                <td>@product.TotalQuantity</td>
                                <td>₹@product.TotalRevenue.ToString("N2")</td>
                            </tr>
                        }

                        @if (ViewBag.BestSellingProducts.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="text-center">
                                    No sales data available.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

    <!-- Monthly Sales Table -->
    <div class="card shadow-sm border-0 mt-4 mb-4">
        <div class="card-body">

            <h4>Monthly Sales Details</h4>

            <div class="table-responsive">
                <table class="table table-bordered table-striped mt-3"
                       id="monthlySalesTable">

                    <thead class="table-dark">
                        <tr>
                            <th>Month</th>
                            <th>Total Sales</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var month in ViewBag.MonthlySales)
                        {
                            <tr>
                                <td>@month.Month</td>
                                <td>₹@month.TotalSales.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>

<!-- Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const salesRows = document.querySelectorAll(
        "#monthlySalesTable tbody tr"
    );

    const monthLabels = [];
    const salesValues = [];

    salesRows.forEach(row => {
        const cells = row.querySelectorAll("td");

        if (cells.length === 2) {
            monthLabels.push(cells[0].innerText.trim());

            const amount = cells[1].innerText
                .replace(/[^\d.-]/g, "");

            salesValues.push(Number(amount) || 0);
        }
    });

    const chartCanvas = document.getElementById("monthlySalesChart");

    new Chart(chartCanvas, {
        type: "line",

        data: {
            labels: monthLabels,

            datasets: [{
                label: "Monthly Sales (₹)",
                data: salesValues,
                borderWidth: 3,
                tension: 0.4,
                fill: true,
                pointRadius: 5,
                pointHoverRadius: 8
            }]
        },

        options: {
            responsive: true,
            maintainAspectRatio: false,

            plugins: {
                legend: {
                    display: true,
                    position: "top"
                }
            },

            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return "₹" + value.toLocaleString("en-IN");
                        }
                    }
                }
            }
        }
    });
</script>
