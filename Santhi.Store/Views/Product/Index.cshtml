
@model IEnumerable<Santhi.Store.Models.Product>

@section Styles {
    <link rel="stylesheet" href="~/css/product.css" />
}

@{
    ViewData["Title"] = "Products";
}

<div class="container mt-4">

    <!-- Page Heading -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Our Products</h2>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Product"
               asp-action="Create"
               class="btn btn-primary">
                + Add New Product
            </a>
        }

    </div>

    <!-- Category Filter -->
    <div class="row mb-4">
        <div class="col-md-4">

            <form asp-controller="Product"
                  asp-action="Index"
                  method="get">

                <label class="form-label fw-bold">
                    Filter by Category
                </label>

                <select name="category"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value="">All Categories</option>

                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category"
                                    selected="@(ViewBag.SelectedCategory == category)">
                                @category
                            </option>
                        }
                    }

                </select>

            </form>

        </div>
    </div>

    <!-- Product Grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">

        @if (Model != null && Model.Any())
        {
            foreach (var product in Model)
            {
                <div class="col">

                    <div class="card shadow-sm h-100 border-0">

                        <!-- Product Image -->
                        <img src="@product.ImageUrl"
                             class="card-img-top"
                             alt="@product.ProductName"
                             style="height:220px; object-fit:cover;" />

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">
                                @product.ProductName
                            </h5>

                            @{
                            var ratingSummary = ViewBag.RatingSummary;
                            double averageRating = 0;
                            int reviewCount = 0;

                            if (ratingSummary != null &&
                                ratingSummary.ContainsKey(product.ProductId))
                            {
                                var summary = ratingSummary[product.ProductId];
                                averageRating = summary.AverageRating;
                                reviewCount = summary.ReviewCount;
                            }
                        }

                        @if (reviewCount > 0)
                        {
                            <div class="mb-2">
                                <span class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(averageRating))
                                        {
                                            <span>★</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">☆</span>
                                        }
                                    }
                                </span>

                                <strong>@averageRating.ToString("0.0") / 5</strong>

                                <small class="text-muted">
                                    (@reviewCount reviews)
                                </small>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mb-2">
                                No reviews yet
                            </p>
                        }

                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@product.ProductId"
                               class="btn btn-outline-primary mb-3">
                                View Details
                            </a>

                            <p class="text-muted mb-2">
                                @product.Category
                            </p>

                            <p class="text-secondary">
                                @product.Description
                            </p>

                            <h5 class="text-primary">
                                ₹@product.Price
                            </h5>

                            @if (product.Stock > 0)
                            {
                                <p class="text-success fw-bold">
                                    Available Stock: @product.Stock
                                </p>
                            }
                            else
                            {
                                <p class="text-danger fw-bold">
                                    Out of Stock
                                </p>
                            }

                           
                            <!-- Product Buttons -->
                            <div class="mt-auto d-grid gap-2">

                                @if (product.Stock > 0)
                                {
                                    <form asp-controller="Cart"
                                          asp-action="AddToCart"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@product.ProductId" />

                                        <button type="button" class="btn btn-primary">
                                            Add to Cart
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-secondary w-100"
                                            disabled>
                                        Out of Stock
                                    </button>
                                }

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-controller="Product"
                                       asp-action="Edit"
                                       asp-route-id="@product.ProductId"
                                       class="btn btn-warning">
                                        Edit Product
                                    </a>

                                    <form asp-controller="Product"
                                          asp-action="Delete"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@product.ProductId" />

                                        <button type="submit"
                                                class="btn btn-danger w-100"
                                                onclick="return confirm('Are you sure you want to delete this product?');">
                                            Delete Product
                                        </button>

                                    </form>
                                }

                            </div>


                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">
                    No products found.
                </div>
            </div>
        }

    </div>

</div>
