
@model Santhi.Store.Models.Product

@{
    ViewData["Title"] = Model.ProductName;

    var reviews = ViewBag.Reviews as
        List<Santhi.Store.Models.ProductReview>
        ?? new List<Santhi.Store.Models.ProductReview>();

    double averageRating = ViewBag.AverageRating ?? 0.0;
}

<div class="container mt-5 mb-5">

    
<!-- Product Details -->
<div class="row mb-5">

    <div class="col-md-6">
        <div style="position:relative; width:100%;">

            <img src="@Model.ImageUrl"
                 alt="@Model.ProductName"
                 class="img-fluid rounded shadow"
                 style="width:100%; height:400px; object-fit:cover;" />

            @if (User.Identity?.IsAuthenticated == true &&
                 User.IsInRole("Customer"))
            {
                <form asp-controller="Wishlist"
                      asp-action="Add"
                      method="post"
                      style="position:absolute; top:12px; right:12px;">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="productId"
                           value="@Model.ProductId" />

                    <button type="submit"
                            title="Add to Wishlist"
                            style="width:45px; height:45px;
                                   border:none; border-radius:50%;
                                   background:white; color:red;
                                   font-size:25px; cursor:pointer;">
                        ❤️
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="col-md-6">

        <h2>@Model.ProductName</h2>

        <p class="text-muted">Category: @Model.Category</p>

        <h3 class="text-primary">₹@Model.Price</h3>

        <p>@Model.Description</p>

        <p>
            <strong>Available Stock:</strong> @Model.Stock
        </p>

        @if (Model.Stock > 0)
        {
            <form asp-controller="Cart"
                  asp-action="AddToCart"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.ProductId" />

                <button type="submit"
                        class="btn btn-primary">
                    🛒 Add to Cart
                </button>

            </form>
        }
        else
        {
            <button type="button"
                    class="btn btn-secondary"
                    disabled>
                Out of Stock
            </button>
        }

        <a asp-action="Index"
           class="btn btn-secondary mt-2">
            Back to Products
        </a>

    </div>

</div>
<!-- Product Details ends here -->


    <hr />

    <!-- Customer Reviews -->
    <div class="mt-4">

        <h3 class="mb-3">Customer Reviews & Ratings</h3>

        <!-- Average Rating -->
        <div class="card mb-4">
            <div class="card-body">

                <h4 class="text-warning">
                    ★ @averageRating.ToString("0.0") / 5
                </h4>

                <p class="text-muted mb-0">
                    Based on @reviews.Count customer review(s)
                </p>

            </div>
        </div>

        <!-- Review Messages -->
        @if (TempData["ReviewMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["ReviewMessage"]
            </div>
        }

        @if (TempData["ReviewError"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ReviewError"]
            </div>
        }

        <!-- Add Review Form -->
        @if (User.Identity?.IsAuthenticated == true &&
             User.IsInRole("Customer"))
        {
            <div class="card mb-4">

                <div class="card-header">
                    <h5 class="mb-0">Write Your Review</h5>
                </div>

                <div class="card-body">

                    <form asp-controller="Product"
                          asp-action="AddReview"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="productId"
                               value="@Model.ProductId" />

                        <div class="mb-3">

                            <label class="form-label">
                                Select Your Rating
                            </label>

                            <select name="rating"
                                    class="form-select"
                                    required>

                                <option value="">Choose rating</option>
                                <option value="5">★★★★★ - Excellent</option>
                                <option value="4">★★★★ - Very Good</option>
                                <option value="3">★★★ - Good</option>
                                <option value="2">★★ - Average</option>
                                <option value="1">★ - Poor</option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Your Review
                            </label>

                            <textarea name="comment"
                                      class="form-control"
                                      rows="4"
                                      minlength="5"
                                      maxlength="1000"
                                      placeholder="Write your product experience..."
                                      required></textarea>

                        </div>

                        <button type="submit"
                                class="btn btn-success">
                            Submit Review
                        </button>

                    </form>

                </div>
            </div>
        }

        <!-- Display All Reviews -->
        <h5 class="mb-3">What Customers Say</h5>

        @if (reviews.Any())
        {
            @foreach (var review in reviews)
            {
                <div class="card mb-3">

                    <div class="card-body">

                        <div class="d-flex justify-content-between flex-wrap">

                            <strong>Verified Customer</strong>

                            <small class="text-muted">
                                @review.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy")
                            </small>

                        </div>

                        <div class="text-warning fs-5 mt-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= review.Rating)
                                {
                                    <span>★</span>
                                }
                                else
                                {
                                    <span class="text-secondary">☆</span>
                                }
                            }
                        </div>

                        <p class="mt-2 mb-0">
                            @review.Comment
                        </p>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">
                No reviews yet. Be the first customer to review this product!
            </div>
        }

    </div>

</div>
