
@model List<Santhi.Store.Models.CartItem>

@{
    ViewData["Title"] = "My Cart";
    decimal total = 0;
}

<div class="container cart-page">

    <h2>My Shopping Cart</h2>
    @if (TempData["OrderMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["OrderMessage"]
        </div>
    }

    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show"
             role="alert">

            @TempData["CartError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">

             <table class="table table-bordered table-hover cart-table mt-4">
                <thead class="table-dark">
                    <tr>
                        <th>Product</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        var subtotal = item.Price * item.Quantity;
                        total += subtotal;

                        <tr>

                            <td>
                                <img src="@item.ImageUrl"
                                     alt="@item.ProductName"
                                     width="70"
                                     height="70"
                                     style="object-fit:cover;" />
                            </td>

                            <td>@item.ProductName</td>

                            <td>₹@item.Price</td>

                            <td>
                                <div class="d-flex align-items-center gap-2">

                                    <!-- Decrease Quantity -->
                                    <a asp-controller="Cart"
                                       asp-action="DecreaseQuantity"
                                       asp-route-id="@item.ProductId"
                                       class="btn btn-danger btn-sm">
                                        −
                                    </a>

                                    <span class="fw-bold">
                                        @item.Quantity
                                    </span>

                                    <!-- Increase Quantity -->
                                    <a asp-controller="Cart"
                                       asp-action="IncreaseQuantity"
                                       asp-route-id="@item.ProductId"
                                       class="btn btn-success btn-sm">
                                        +
                                    </a>

                                </div>
                            </td>

                            <td>₹@subtotal</td>

                            <td>
                                <!-- Remove Product -->
                                <a asp-controller="Cart"
                                   asp-action="RemoveFromCart"
                                   asp-route-id="@item.ProductId"
                                   class="btn btn-outline-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to remove this product?');">
                                    Remove
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

       
        <div class="text-end mt-4">
            <a asp-controller="Checkout"
               asp-action="Index"
               class="btn btn-primary btn-lg">
                Proceed to Checkout →
            </a>
        </div>

    }
    else
    {
        <div class="alert alert-info mt-4">
            Your cart is currently empty.
        </div>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-success mt-3">
        Continue Shopping
    </a>

</div>
