{
  "ReverseProxy": {
    "Routes": {
      "storeRoute": {
        "ClusterId": "storeCluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "storeCluster": {
        "Destinations": {
          "server1": {
            "Address": "http://localhost:5001/"
          },
          "server2": {
            "Address": "http://localhost:5002/"
          }
        }
      }
    }
  }
}
